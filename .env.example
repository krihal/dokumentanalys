HF_TOKEN=hf_your_token_here

# LLM backend the worker talks to. Pick one:
#   Ollama (default):          LLM_URL=http://localhost:11434
#   vLLM / mlx-lm / llama-server / Ollama's OpenAI endpoint:
#                              LLM_URL=http://localhost:8000/v1
# LLM_API=auto picks "openai" when the URL ends in /v1, else "ollama".
LLM_URL=http://localhost:11434
LLM_API=auto
# Prompts contain document text. The worker refuses an LLM_URL that is not this
# machine or a private network, and plain http to anything but this machine.
# ALLOW_REMOTE_LLM=1 permits e.g. a hosted API (document text leaves the network).
# ALLOW_INSECURE_LLM=1 permits http on a private network that is already encrypted.
ALLOW_REMOTE_LLM=0
ALLOW_INSECURE_LLM=0
# Never enable prompt logging on the LLM server (OLLAMA_DEBUG, vLLM request logs, llama-server --verbose).
# Optional bearer token (vLLM --api-key, hosted endpoints)
LLM_API_KEY=
# Let reasoning models think before answering (slower, usually not needed)
LLM_THINK=0
# Sampling. 0 and a fixed seed give the same answer to the same question.
# Raise the temperature (e.g. 0.7) for more varied wording.
LLM_TEMPERATURE=0.5
LLM_SEED=42

# Chat model id as the backend names it (Ollama: gemma4:26b, vLLM: google/gemma-4-31B-it)
MODEL=gemma4:26b
# Context window in tokens. Sent per request to Ollama. For OpenAI-style
# backends it must match the server (vLLM --max-model-len, llama-server -c);
# it still sizes the prompt the worker builds.
NUM_CTX=65536

# Retrieval models (sentence-transformers names)
EMBED_MODEL=intfloat/multilingual-e5-small
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# On a CUDA box with headroom, this re-ranker scores clearly better:
# RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Required by app.py, at least 32 characters. Generate with: openssl rand -hex 32
STORAGE_SECRET=change-me
# Shared secret between app.py and worker.py (same value on both machines)
WORKER_TOKEN=change-me

# Encrypted user vault (accounts, keys, documents). Back it up; it is useless without passphrases.
VAULT_DIR=./vault
# The app binds to localhost; put a TLS reverse proxy in front of it.
APP_HOST=127.0.0.1
APP_PORT=7777
# Session cookie only over HTTPS. Set 0 only for plain-http development.
COOKIE_SECURE=1
# Reverse proxies whose X-Forwarded-For is trusted for the login lockout (comma-separated),
# e.g. TRUSTED_PROXIES=127.0.0.1 when Caddy/nginx runs on this machine.
TRUSTED_PROXIES=
# The decrypted key is dropped after this much inactivity, and after the max age.
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
MAX_UPLOAD_MB=50
# ZIP archives are unpacked in memory one file at a time; each file still at most MAX_UPLOAD_MB
MAX_ZIP_MB=500

# Worker: OCR scanned PDF pages (needs tesseract)
OCR=0
# Worker: allow ws:// to a non-local UI server (only inside an already encrypted tunnel)
ALLOW_INSECURE_WORKER=0
