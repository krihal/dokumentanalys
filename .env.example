HF_TOKEN=hf_your_token_here

# LLM backend the worker talks to. Pick one:
#   Ollama (default):          LLM_URL=http://localhost:11434
#   vLLM / mlx-lm / llama-server / Ollama's OpenAI endpoint:
#                              LLM_URL=http://localhost:8000/v1
# LLM_API=auto picks "openai" when the URL ends in /v1, else "ollama".
LLM_URL=http://localhost:11434
LLM_API=auto
# Optional bearer token (vLLM --api-key, hosted endpoints)
LLM_API_KEY=
# Let reasoning models think before answering (slower, usually not needed)
LLM_THINK=0

# Chat model id as the backend names it (Ollama: gemma4:26b, vLLM: google/gemma-4-31B-it)
MODEL=gemma4:26b
# Context window in tokens. Sent per request to Ollama. For OpenAI-style
# backends it must match the server (vLLM --max-model-len, llama-server -c);
# it still sizes the prompt the worker builds.
NUM_CTX=65536

# Retrieval models (sentence-transformers names)
EMBED_MODEL=intfloat/multilingual-e5-small
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# On a CUDA box with headroom, this re-ranker scores clearly better:
# RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Required by app.py. Generate with: openssl rand -hex 24
APP_PASSWORD=change-me
STORAGE_SECRET=change-me
# Shared secret between app.py and worker.py (same value on both machines)
WORKER_TOKEN=change-me
